{
  "name": "opencode-go-to-codex-api-1",
  "version": "1.0.0",
  "description": "API proxy that converts OpenCode Go API to Codex (OpenAI-compatible) API format. Supports Cloudflare Workers/Pages and Docker deployment.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "cf:dev": "npx wrangler dev",
    "cf:deploy": "npx wrangler deploy"
  },
  "keywords": ["opencode", "codex", "api", "proxy", "cloudflare-workers"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
